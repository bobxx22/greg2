# Copy to .env.local for local development; on Vercel set these in
# Project Settings -> Environment Variables. Never commit real values.

# --- Admin panel ---
ADMIN_USERNAME=
ADMIN_PASSWORD=
JWT_SECRET=

# --- Database ---
MONGODB_URI=
MONGODB_DB=

# --- Payments (Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_ID=

# --- Cloudflare Turnstile ---
CLOUDFLARE_TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=

# --- Cron (vercel.json -> /api/cron/expire-bookings) ---
# Any long random string. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
# Days before an unpaid booking expires (optional)
BOOKING_UNPAID_EXPIRY_DAYS=

# --- Public app settings ---
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_BOOKING_PRICE=
